# Copy to .env next to docker-compose.yml and adjust. Never commit .env.

# ---- HoneyMOM ----
# 1 = demo mode (demo accounts with password honey123, demo plant data). docker/compose.production.yml sets 0.
MOM_DEMO=1
# Demo dataset language, en or zh. Chosen when the database is first seeded.
MOM_DEMO_LANG=en
# Server default language (en or zh-CN) for requests without a language and for background texts. Empty = demo
# language in demo mode, otherwise en.
MOM_LANG=
# Host port of the web UI and API.
MOM_PORT=8900
# Time zone of the containers (data clock, shifts, reports). Example: Europe/Berlin, Asia/Shanghai.
TZ=UTC
# Image to run. Default honeymom:local is built from this checkout; or use a published image, e.g.
# HONEYMOM_IMAGE=ghcr.io/honeymeta/honeymom:latest
HONEYMOM_IMAGE=honeymom:local

# ---- PostgreSQL ----
POSTGRES_USER=honeymom
# Required in production. Use letters and digits only, or URL-encode it: it is also part of MOM_DB.
POSTGRES_PASSWORD=
POSTGRES_DB=honeymom

# ---- AI (OpenAI-compatible chat completions endpoint) ----
# No defaults. AI calls a model only when all three are set; otherwise AI features use rule-based fallbacks or
# the recorded demo answers. Each feature must also be switched on under System -> AI features.
MOM_LLM_BASE_URL=
MOM_LLM_API_KEY=
MOM_LLM_MODEL=

# ---- Replayer ----
# Playback speed factor (1 = real time, 10 = one recorded day in 2.4 hours).
REPLAYER_SPEED=1
