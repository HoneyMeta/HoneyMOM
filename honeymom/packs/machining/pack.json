   "import": "kb_doc",
   "rows": [
    {
     "title": "CNC 换刀作业指导",
     "tags": "工艺,机加",
     "content": "T03 Φ8 钻头寿命 100 件，到数自动换刀。\n换刀后首件必须测头复测缸孔，并做首件检验。\n主轴负载比换刀后初始值高 30% 以上时提前换刀（MES 刀具监测会预警）。\n钻头磨损会使交叉孔毛刺变大，是内窥检测毛刺 NG 的主要来源。",
     "updated": "@now",
     "kind": "sop",
     "process": "P60"
    }
   ]
  }
