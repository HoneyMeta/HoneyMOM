    "injection",
    "mold_temp",
    "chiller"
   ]
  }
 ],
 "kpis": [
  {
   "key": "cycle_attain",
   "label": "成型周期达成率",
   "unit": "%",
   "target": 95,
   "dir": "up",
   "desc": "标准周期 ÷ 实际周期（按模具 / 机台）"
  },
  {
   "key": "smed",
   "label": "平均换模时间",
   "unit": "min",
   "target": 30,
   "dir": "down",
   "desc": "上一模最后一件到下一模首件合格"
  },
  {
   "key": "fpy",
   "label": "注塑一次合格率",
   "unit": "%",
   "target": 98.5,
   "dir": "up",
   "desc": "外观全检一次合格 ÷ 成型数"
  },
  {
   "key": "regrind",
   "label": "水口料比例",
   "unit": "%",
   "target": 8,
   "dir": "down",
   "desc": "浇口料 + 不良粉碎回用 ÷ 原料投入"
  },
  {
   "key": "mold_life",
   "label": "模具寿命消耗",
   "unit": "%",
   "target": 80,
   "dir": "down",
   "desc": "当前模次 ÷ 寿命模次（超过 80% 安排保养 / 备模）"
  }
 ],
 "reports": [
  {
   "name": "注塑缺陷排列",
   "dataset": "ncr",
   "chart": "bar",
   "shared_roles": [
    "qc",
    "engineer",
    "manager"
   ],
   "config": {
    "filters": [
     {
      "field": "defect__category",
      "op": "=",
      "value": "molding"
     }
    ],
    "group": [
     {
      "field": "defect__label"
     }
    ],
    "measures": [
     {
      "field": "qty",
      "agg": "sum",
      "label": "数量"
     }
    ],
    "sort": [
     {
      "field": "qty_sum",
      "dir": "desc"
     }
    ]
   }
  },
  {
   "name": "模具模次与寿命",
   "dataset": "tooling",
   "chart": "bar",
   "shared_roles": [
    "maint",
    "engineer",
    "manager"
   ],
   "config": {
    "group": [
     {
      "field": "name"
     }
    ],
    "measures": [
     {
      "field": "shots",
      "agg": "max",
      "label": "当前模次"
     },
     {
      "field": "life_shots",
      "agg": "max",
      "label": "寿命模次"
     }
    ]
   }
  },
  {
   "name": "注塑机报工（按机台）",
   "dataset": "report",
   "chart": "bar",
   "shared_roles": [
    "leader",
    "manager"
   ],
   "config": {
    "filters": [
     {
      "field": "end",
      "op": "last_days",
      "value": 7
     }
    ],
    "group": [
     {
      "field": "equipment__label"
     }
    ],
    "measures": [
     {
      "field": "qty_good",
      "agg": "sum",
      "label": "合格"
     },
     {
      "field": "qty_ng",
      "agg": "sum",
      "label": "不良"
     }
    ]
   }
  }
 ],
